first_num = int(input('Enter first number'))
math_operator = input('Select math operator i.e +,-,* or /')
second_num = int(input('Enter second number'))

if math_operator == '+':
     answer = first_num + second_num
     print(f"The result of {first_num} + {second_num} is {answer}")
elif math_operator == '-':
    answer = first_num - second_num
    print(f"The result of {first_num} - {second_num} is {answer}")
elif math_operator == '/':
    answer = first_num / second_num
    print(f"The result of {first_num} / {second_num} is {answer}")
elif math_operator == '*':
    answer = first_num * second_num
    print(f"The result of {first_num} * {second_num} is {answer}")
else:
    print("Invalid operator. Please choose one of +, -, *, /.")
    

